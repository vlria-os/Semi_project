<!--            </if>-->
            <!--상품명 or 카테고리명 검색  -->

        SELECT
            p.product_id,
            p.product_name,
            p.price,
            p.unit,
            p.product_type,
            p.category_id,
            c.category_path,
            sum(s.quantity) as quantity<!--집계함수적용-->
        FROM product p
        JOIN (
        SELECT
                category_id,
                LTRIM(SYS_CONNECT_BY_PATH(category_name, '>'), '>') AS category_path
            FROM category
            START WITH parent_id IS NULL
            CONNECT BY PRIOR category_id = parent_id
        ) c ON p.category_id = c.category_id
        join stock s on p.product_id=s.product_id

        <where>
            <if test="keyword != null and keyword.trim() != ''">
                p.product_name LIKE '%' || #{keyword} || '%'
                OR c.category_path LIKE '%' || #{keyword} || '%'
            </if>
            <if test="product_type != null and product_type !=''">
                and  p.product_type = #{product_type}
            </if>
        </where>
        group by
            p.product_id,
            p.product_name,
            p.price,
            p.unit,
            p.product_type,
            p.category_id,
            c.category_path

    </select>
</mapper>