<mapper namespace="com.example.demo.mapper.ProductMapper">
    <select id="selectAll" resultType="ProductDto">
        select * from product
    </select>

    <sql id="productSearch">
        <where>
            <if test="searchDto.field != null and searchDto.field != '' and searchDto.field != 'all' ">
                and upper(p.status) = upper(#{searchDto.field})
            </if>
            <if test="searchDto.keyword != null and searchDto.keyword != '' ">
                and (
                    upper (p.product_name) like '%' || upper(#{searchDto.keyword}) || '%'
                    or upper (c.category_path) like '%' || upper(#{searchDto.keyword}) || '%'
                    or cast (p.product_id as varchar2(10)) like '%' || upper(#{searchDto.keyword}) || '%'
                )
            </if>
        </where>
    </sql>

    <select id="selectAllKeyword" parameterType="map" resultType="ProductDto">
        select * from (
            select rownum rn,
                data.* from (
                    select
                        p.product_id,
                        p.product_name,
                        p.price,
                        p.unit,
                        p.status,
                        p.category_id,
                        c.category_path as category,
                        i.save_name as save_name from product p
                    join (
                        select
                            category_id,
                            LTRIM (SYS_CONNECT_BY_PATH (category_name, '>'), '>') as category_path
                        from category
                        start with parent_id is null
                        connect by prior category_id = parent_id
                    ) c on p.category_id = c.category_id
                    left join product_image i on p.image_id = i.image_id
                    <include refid="productSearch"/>
                    order by p.product_id desc
                ) data
            )
        <![CDATA[
        where rn >= #{startRow} and rn <= #{endRow}
        ]]>
    </select>

    <select id="count" resultType="int" parameterType="map">
        select count(*)
            from product p
                join (
                select
                category_id,
                ltrim(sys_connect_by_path(category_name,'>'),'>') as category_path
                from category
                start with parent_id is null
                connect by prior category_id = parent_id
                ) c on p.category_id = c.category_id
            left join product_image i on p.image_id = i.image_id
        <include refid="productSearch"/>
