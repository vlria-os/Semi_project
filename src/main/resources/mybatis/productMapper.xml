    <update id="updateProduct" parameterType="ProductDto">
        update product
        <set>
            <if test="product_name != null">product_name = #{product_name},</if>
            <if test="category_id != 0">category_id= #{category_id},</if>
            <if test="price != 0">price= #{price},</if>
            <if test="unit != null">unit= #{unit},</if>
            <if test="status !=null">status= #{status},</if>
            <if test="image_id != 0">image_id= #{image_id}</if>
        </set>
        where product_id= #{product_id}
    </update>

    <select id="selectOneProduct" parameterType="int" resultType="ProductDto">
        select
            p.product_id,
            p.product_name,
            p.price,
            p.unit,
            p.status,
            p.category_id,
            c.category_path as category
        from product p
        join (
            select
                category_id,
                LTRIM (SYS_CONNECT_BY_PATH (category_name, '>'), '>') as category_path
            from category
            start with parent_id is null
            connect by prior category_id= parent_id
        ) c on p.category_id= c.category_id
        where p.product_id= #{productId}
    </select>

    <delete id="deleteProduct" parameterType="int">
        delete from product where product_id= #{product_id}
    </delete>

    <select id="select_price" parameterType="int" resultType="int">
        select price from product where product_id=#{value}
    </select>

