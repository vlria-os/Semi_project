    <select id="selectOne_category" parameterType="String" resultType="int">
        select category_id from category where category_name=#{value}
    </select>
    <insert id="insert" parameterType="ProductDto">
        insert into product(
            product_id,
            product_name,
            category_id,
            price,
            unit,
            image_id,
            status
        ) values(
            product_seq.nextval,
            #{product_name},
            #{category_id},
            #{price},
            #{unit},
            #{image_id},
            #{status}
        )
    </insert>
    <insert id="insert_image" parameterType="Product_imageDto">
        <selectKey keyProperty="image_id" resultType="int" order="BEFORE">
            SELECT image_seq.NEXTVAL FROM dual
        </selectKey>
        insert into product_image values (
            #{image_id},
            #{file_path},
            #{save_name}
        )
    </insert>
    <!-- 대분류 조회 -->
    <select id="selectRootCategories" resultType="CategoryDto">
        select category_id,category_name
        from category where parent_id is null
        order by category_id
    </select>
    <!-- 하위 카테고리 조회 -->
    <select id="selectChildrenByParentId" resultType="CategoryDto">
        select category_id,category_name,parent_id
        from category where parent_id = #{parentId}
        order by category_id
    </select>
    <!-- 상품명 조회 -->
    <select id="selectProductName" resultType="string">
        select product_name from product where product_id=#{productId}
    </select>
    <insert id="insert_category" parameterType="CategoryDto">
        insert into category values(category_seq.nextval,#{category_name},#{parent_id})
    </insert>
    <insert id="insert_firstcategory" parameterType="CategoryDto">
        insert into category values(category_seq.nextval,#{category_name},null)
    </insert>
</mapper>